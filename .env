# Frontend Next.js production server, chi dung khi tu chay tren VPS/local.
WEB_HOST=127.0.0.1
WEB_PORT=3000

# Vercel frontend goi backend public qua subdomain API.
NEXT_PUBLIC_API_URL=https://api.quynhdiem.com/api

# Next.js rewrite /api ve backend public neu path /api van duoc dung.
NEXT_PRIVATE_BACKEND_ORIGIN=https://api.quynhdiem.com

# Domain public cua web, dung cho allow-list dev origins cua Next.js.
PUBLIC_WEB_URL=https://quynhdiem.com,https://www.quynhdiem.com
