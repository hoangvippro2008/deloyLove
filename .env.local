# ============================================================
# Override chi cho chay LOCALHOST (dev). File nay uu tien hon .env.
# KHONG dung cho production. Co the xoa khi deploy that.
# ============================================================

# Browser goi /api cung origin (localhost:3000) -> Next rewrite chuyen tiep
# toi backend duoi day (phia server, nen KHONG bi CORS chan).
NEXT_PUBLIC_API_URL=/api

# Dich cua rewrite /api -> backend Express dang chay local.
NEXT_PRIVATE_BACKEND_ORIGIN=http://127.0.0.1:4000
